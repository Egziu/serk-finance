# Copy to .env.release (mode 0600); never commit it or print compose config output.
# Use URL-encoded database passwords. Examples are deliberately unusable.
SERK_ENV=staging
SERK_IMAGE=registry.example.com/serk-finance@sha256:REPLACE_WITH_VERIFIED_DIGEST
SERK_ORIGIN=https://finance.example.com
DATABASE_URL=postgres://serk_api_login:REPLACE@db.example.com:5432/serk?sslmode=verify-full&sslrootcert=/run/serk/db-ca.pem
AUTH_DATABASE_URL=postgres://serk_auth_login:REPLACE@db.example.com:5432/serk?sslmode=verify-full&sslrootcert=/run/serk/db-ca.pem
SERK_DB_CA_PATH=/absolute/path/to/public-database-ca.pem
# Set only the immediate ingress source address as seen by the API (e.g. /32).
# The proxy must overwrite X-Real-IP. Do not trust an entire shared cloud subnet.
SERK_TRUSTED_PROXY_CIDRS=

# Shared by the API replicas and the offline MFA enrollment command. Back up separately.
SERK_MFA_KEY_PATH=/absolute/path/to/mfa-key
