#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
  if ! id serk-finance >/dev/null 2>&1; then
    adduser --system --group --home /var/lib/serk-finance --no-create-home --shell /usr/sbin/nologin serk-finance >/dev/null
  fi
  install -d -m 0700 -o serk-finance -g serk-finance /var/lib/serk-finance
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable serk-finance >/dev/null 2>&1 || true
    systemctl restart serk-finance || true
  fi
  echo "Serk Finance: open http://localhost:8080 to set up your company (back up with: sudo serk-finance backup)."
fi
exit 0
